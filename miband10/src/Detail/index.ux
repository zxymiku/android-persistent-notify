<template>
  <div class="page">
    <div class="header">
      <text class="back" onclick="goBack">◀ 返回</text>
      <text class="tag">{{ item.t }}</text>
    </div>
    <scroll class="body">
      <text class="qtitle">题目</text>
      <text class="qtext">{{ item.q }}</text>
      <div class="divider"></div>
      <text class="atitle">答案</text>
      <text class="atext">{{ item.a }}</text>
    </scroll>
  </div>
</template>

<style>
  .page {
    flex-direction: column;
    background-color: #0d0d0d;
    width: 212px;
    height: 520px;
  }
  .header {
    flex-direction: column;
    padding: 10px 12px 8px 12px;
    border-bottom-width: 2px;
    border-bottom-color: #ffd902;
  }
  .back {
    color: #ffd902;
    font-size: 13px;
  }
  .tag {
    color: #8a8a8a;
    font-size: 11px;
    margin-top: 4px;
  }
  .body {
    flex: 1;
    flex-direction: column;
    padding: 10px 12px 16px 12px;
  }
  .qtitle {
    color: #ffd902;
    font-size: 12px;
    font-weight: bold;
  }
  .qtext {
    color: #ededed;
    font-size: 14px;
    line-height: 20px;
    margin-top: 4px;
    text-align: left;
  }
  .divider {
    height: 2px;
    background-color: #2e2e2e;
    margin: 10px 0;
  }
  .atitle {
    color: #ffd902;
    font-size: 12px;
    font-weight: bold;
  }
  .atext {
    color: #ededed;
    font-size: 12px;
    line-height: 17px;
    margin-top: 4px;
    text-align: left;
  }
</style>

<script>
  var router = require('@system.router');
  var data = require('../Common/data.js');

  module.exports = {
    data: {
      id: 0,
      item: { t: '', q: '', a: '' }
    },
    onInit: function () {
      for (var i = 0; i < data.questions.length; i++) {
        if (data.questions[i].id === this.id) {
          this.item = data.questions[i];
          break;
        }
      }
    },
    goBack: function () {
      router.back();
    }
  };
</script>
